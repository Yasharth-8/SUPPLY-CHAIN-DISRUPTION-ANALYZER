# ==============================================================================
# Supply Chain Disruption Analyzer - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      copy .env.example .env     (Windows)
#      cp .env.example .env       (Linux/macOS)
# 2. Add your Google Gemini API key(s) below.
# 3. NEVER commit your actual .env file or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Google Gemini API Key (Required)
# Get a key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Multi-Key Rotation Pool (Optional)
# The system automatically pools and rotates across configured keys with seamless
# failover to stay well within Gemini Flash free tier rate limits (1,500 req/day per key).
# ------------------------------------------------------------------------------
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=

# ------------------------------------------------------------------------------
# Model Settings
# Supported models: gemini-3.5-flash-lite (recommended default), gemini-2.5-flash
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite

# Fast Grounded Mode: When enabled, accelerates card scoring for rapid evaluation (true/false)
FAST_GROUNDED_MODE=false

# ------------------------------------------------------------------------------
# Custom Storage Directories (Optional - defaults to relative project paths)
# ------------------------------------------------------------------------------
# DOCS_DIR=docs
# CASES_DIR=cases
# MEMORY_DIR=memory
# LOGS_DIR=logs
